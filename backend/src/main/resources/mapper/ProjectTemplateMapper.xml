<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.project.mapper.ProjectTemplateMapper">

    <resultMap id="templateMap" type="com.therecommerce.workmap.project.domain.ProjectTemplate">
        <id     property="id"                column="id"/>
        <result property="code"              column="code"/>
        <result property="name"              column="name"/>
        <result property="description"       column="description"/>
        <result property="icon"              column="icon"/>
        <result property="defaultTabs"       column="default_tabs"
                typeHandler="com.therecommerce.workmap.common.mybatis.StringListJsonTypeHandler"/>
        <result property="defaultWorkflowId" column="default_workflow_id"/>
        <result property="issueTypeCodes"    column="issue_type_codes"
                typeHandler="com.therecommerce.workmap.common.mybatis.StringListJsonTypeHandler"/>
        <result property="isSystem"          column="is_system"/>
        <result property="sortOrder"         column="sort_order"/>
    </resultMap>

    <select id="findById" resultMap="templateMap">
        SELECT * FROM project_template WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="templateMap">
        SELECT * FROM project_template ORDER BY sort_order, id
    </select>

</mapper>
