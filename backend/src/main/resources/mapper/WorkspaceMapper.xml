<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.workspace.mapper.WorkspaceMapper">

    <resultMap id="workspaceMap" type="com.therecommerce.workmap.workspace.domain.Workspace">
        <id     property="id"          column="id"/>
        <result property="name"        column="name"/>
        <result property="description" column="description"/>
        <result property="createdBy"   column="created_by"/>
        <result property="createdAt"   column="created_at"/>
        <result property="updatedAt"   column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.workspace.domain.Workspace"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO workspaces (name, description, created_by)
        VALUES (#{name}, #{description}, #{createdBy})
    </insert>

    <select id="findById" resultMap="workspaceMap">
        SELECT * FROM workspaces WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="workspaceMap">
        SELECT * FROM workspaces ORDER BY id
    </select>

    <update id="update" parameterType="com.therecommerce.workmap.workspace.domain.Workspace">
        UPDATE workspaces
        SET name        = #{name},
            description = #{description},
            updated_at  = now()
        WHERE id = #{id}
    </update>

</mapper>
