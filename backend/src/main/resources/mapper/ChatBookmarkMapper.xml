<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.chat.mapper.ChatBookmarkMapper">

    <resultMap id="bookmarkMap" type="com.therecommerce.workmap.chat.domain.ChatBookmark">
        <id     property="id"        column="id"/>
        <result property="userId"    column="user_id"/>
        <result property="messageId" column="message_id"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.chat.domain.ChatBookmark"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO chat_bookmarks (user_id, message_id)
        VALUES (#{userId}, #{messageId})
    </insert>

    <select id="findByUserAndMessage" resultMap="bookmarkMap">
        SELECT id, user_id, message_id, created_at
        FROM chat_bookmarks
        WHERE user_id = #{userId} AND message_id = #{messageId}
    </select>

    <select id="findByUser" resultMap="bookmarkMap">
        SELECT id, user_id, message_id, created_at
        FROM chat_bookmarks
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
    </select>

    <delete id="delete">
        DELETE FROM chat_bookmarks
        WHERE user_id = #{userId} AND message_id = #{messageId}
    </delete>

</mapper>
