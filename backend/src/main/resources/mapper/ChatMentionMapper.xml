<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.chat.mapper.ChatMentionMapper">

    <resultMap id="mentionMap" type="com.therecommerce.workmap.chat.domain.ChatMention">
        <id     property="id"              column="id"/>
        <result property="messageId"       column="message_id"/>
        <result property="replyId"         column="reply_id"/>
        <result property="mentionedUserId" column="mentioned_user_id"/>
        <result property="createdAt"       column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.chat.domain.ChatMention"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO chat_mentions (message_id, reply_id, mentioned_user_id)
        VALUES (#{messageId}, #{replyId}, #{mentionedUserId})
    </insert>

    <select id="findByMentionedUser" resultMap="mentionMap">
        SELECT id, message_id, reply_id, mentioned_user_id, created_at
        FROM chat_mentions
        WHERE mentioned_user_id = #{mentionedUserId}
        ORDER BY created_at DESC, id DESC
    </select>

</mapper>
