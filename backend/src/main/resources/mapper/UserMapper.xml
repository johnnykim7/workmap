<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.user.mapper.UserMapper">

    <resultMap id="userMap" type="com.therecommerce.workmap.user.domain.User">
        <id     property="id"           column="id"/>
        <result property="email"        column="email"/>
        <result property="passwordHash" column="password_hash"/>
        <result property="name"         column="name"/>
        <result property="role"         column="role"/>
        <result property="departmentId" column="department_id"/>
        <result property="isActive"     column="is_active"/>
        <result property="createdAt"    column="created_at"/>
        <result property="updatedAt"    column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.user.domain.User"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO users (email, password_hash, name, role, department_id, is_active)
        VALUES (#{email}, #{passwordHash}, #{name}, #{role}, #{departmentId}, #{isActive})
    </insert>

    <select id="findById" resultMap="userMap">
        SELECT * FROM users WHERE id = #{id}
    </select>

    <select id="findByEmail" resultMap="userMap">
        SELECT * FROM users WHERE email = #{email}
    </select>

    <select id="existsByEmail" resultType="boolean">
        SELECT EXISTS(SELECT 1 FROM users WHERE email = #{email})
    </select>

    <select id="search" resultMap="userMap">
        SELECT * FROM users
        <where>
            <if test="keyword != null and keyword != ''">
                (name ILIKE '%' || #{keyword} || '%' OR email ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{page.pageSize} OFFSET #{page.offset}
    </select>

    <select id="countSearch" resultType="long">
        SELECT count(*) FROM users
        <where>
            <if test="keyword != null and keyword != ''">
                (name ILIKE '%' || #{keyword} || '%' OR email ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
    </select>

    <update id="update" parameterType="com.therecommerce.workmap.user.domain.User">
        UPDATE users
        SET name          = #{name},
            role          = #{role},
            department_id = #{departmentId},
            updated_at    = now()
        WHERE id = #{id}
    </update>

    <update id="updatePassword">
        UPDATE users SET password_hash = #{passwordHash}, updated_at = now() WHERE id = #{id}
    </update>

    <update id="deactivate">
        UPDATE users SET is_active = false, updated_at = now() WHERE id = #{id}
    </update>

</mapper>
