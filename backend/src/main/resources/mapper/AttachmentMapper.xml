<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.workitem.mapper.AttachmentMapper">

    <resultMap id="attachmentMap" type="com.therecommerce.workmap.workitem.domain.Attachment">
        <id     property="id"          column="id"/>
        <result property="workItemId"  column="work_item_id"/>
        <result property="fileName"    column="file_name"/>
        <result property="filePath"    column="file_path"/>
        <result property="fileSize"    column="file_size"/>
        <result property="contentType" column="content_type"/>
        <result property="uploadedBy"  column="uploaded_by"/>
        <result property="createdAt"   column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.workitem.domain.Attachment"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO attachments (work_item_id, file_name, file_path, file_size, content_type, uploaded_by)
        VALUES (#{workItemId}, #{fileName}, #{filePath}, #{fileSize}, #{contentType}, #{uploadedBy})
    </insert>

    <select id="findByWorkItem" resultMap="attachmentMap">
        SELECT * FROM attachments WHERE work_item_id = #{workItemId} ORDER BY created_at, id
    </select>

    <select id="findById" resultMap="attachmentMap">
        SELECT * FROM attachments WHERE id = #{id}
    </select>

    <delete id="deleteById">
        DELETE FROM attachments WHERE id = #{id}
    </delete>

</mapper>
