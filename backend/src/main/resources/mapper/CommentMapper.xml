<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.workitem.mapper.CommentMapper">

    <resultMap id="commentMap" type="com.therecommerce.workmap.workitem.domain.Comment">
        <id     property="id"               column="id"/>
        <result property="workItemId"       column="work_item_id"/>
        <result property="authorId"         column="author_id"/>
        <result property="content"          column="content"/>
        <result property="mentionedUserIds" column="mentioned_user_ids"
                typeHandler="com.therecommerce.workmap.common.mybatis.LongListJsonTypeHandler"/>
        <result property="createdAt"        column="created_at"/>
        <result property="updatedAt"        column="updated_at"/>
    </resultMap>

    <insert id="insert" parameterType="com.therecommerce.workmap.workitem.domain.Comment"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO comments (work_item_id, author_id, content, mentioned_user_ids)
        VALUES (#{workItemId}, #{authorId}, #{content},
                #{mentionedUserIds, typeHandler=com.therecommerce.workmap.common.mybatis.LongListJsonTypeHandler})
    </insert>

    <select id="findByWorkItem" resultMap="commentMap">
        SELECT * FROM comments WHERE work_item_id = #{workItemId} ORDER BY created_at, id
    </select>

</mapper>
