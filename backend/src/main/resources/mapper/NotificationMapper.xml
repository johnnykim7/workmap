<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.notification.mapper.NotificationMapper">

    <insert id="insert" parameterType="com.therecommerce.workmap.notification.domain.Notification"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO notifications (recipient_id, type, work_item_id, message, is_read)
        VALUES (#{recipientId}, #{type}, #{workItemId}, #{message}, #{isRead})
    </insert>

</mapper>
