<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.therecommerce.workmap.measure.mapper.MeasureUnitMapper">

    <resultMap id="measureUnitMap" type="com.therecommerce.workmap.measure.domain.MeasureUnit">
        <id     property="id"        column="id"/>
        <result property="name"      column="name"/>
        <result property="valueType" column="value_type"/>
        <result property="suffix"    column="suffix"/>
        <result property="options"   column="options"
                typeHandler="com.therecommerce.workmap.common.mybatis.StringListJsonTypeHandler"/>
        <result property="isSystem"  column="is_system"/>
        <result property="sortOrder" column="sort_order"/>
    </resultMap>

    <select id="findById" resultMap="measureUnitMap">
        SELECT * FROM measure_unit WHERE id = #{id}
    </select>

    <select id="findAll" resultMap="measureUnitMap">
        SELECT * FROM measure_unit
        ORDER BY sort_order ASC, id ASC
        LIMIT #{limit} OFFSET #{offset}
    </select>

    <select id="countAll" resultType="long">
        SELECT count(*) FROM measure_unit
    </select>

    <insert id="insert" parameterType="com.therecommerce.workmap.measure.domain.MeasureUnit"
            useGeneratedKeys="true" keyProperty="id" keyColumn="id">
        INSERT INTO measure_unit (name, value_type, suffix, options, is_system, sort_order)
        VALUES (
            #{name}, #{valueType}, #{suffix},
            #{options, typeHandler=com.therecommerce.workmap.common.mybatis.StringListJsonTypeHandler},
            #{isSystem}, #{sortOrder})
    </insert>

    <update id="update" parameterType="com.therecommerce.workmap.measure.domain.MeasureUnit">
        UPDATE measure_unit
        SET name       = #{name},
            value_type = #{valueType},
            suffix     = #{suffix},
            options    = #{options, typeHandler=com.therecommerce.workmap.common.mybatis.StringListJsonTypeHandler},
            sort_order = #{sortOrder}
        WHERE id = #{id}
    </update>

    <delete id="delete">
        DELETE FROM measure_unit WHERE id = #{id}
    </delete>

    <select id="isInUse" resultType="boolean">
        SELECT EXISTS (
            SELECT 1 FROM work_items WHERE measure_unit_id = #{id} AND deleted_at IS NULL
        )
    </select>

</mapper>
